{
  "name": "vulnscan-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend for the authorized web vulnerability scanner: crawler, safe detection modules and scan job API.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "SCAN_RATE_LIMIT=500 API_RATE_LIMIT=5000 node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  }
}
