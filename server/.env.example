# Copy to .env and adjust as needed (the server also runs fine with no .env file).
PORT=4000
HOST=127.0.0.1

# Browser origins allowed to call this API (comma separated).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Finished scans kept in server memory. Long-term history lives in the browser.
SCAN_RETENTION=25

# Scans allowed to run at the same time.
MAX_CONCURRENT_SCANS=2

# Identify yourself to the sites you are authorized to test. Add contact details
# so a site owner seeing this in their logs knows who to reach.
# SCANNER_USER_AGENT=VulnScanner/1.0 (+authorized-security-testing; contact: you@example.com)

# DANGER - default is off, and it should stay off unless you understand this.
# Allows scanning localhost and private network addresses so you can test your
# own app in development or on a staging network. While it is on, this backend
# can reach internal hosts on behalf of whoever can call its API, which is the
# SSRF pivot the guard normally prevents. Never enable it on a shared machine,
# a server, or any deployment reachable by someone else.
# ALLOW_PRIVATE_TARGETS=true
